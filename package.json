{
  "name": "warrantee",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:business": "playwright test tests/e2e/business-workflows.spec.ts",
    "test:e2e:operational": "OPERATIONAL_E2E=1 playwright test tests/e2e/operational-workflows.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "warrantee:cli": "node tools/warrantee/cli.mjs",
    "warrantee:mcp": "node tools/warrantee/mcp-server.mjs",
    "pack:cli": "npm pack ./packages/warrantee-cli --dry-run",
    "qa:cli-release": "node scripts/check-cli-release.mjs",
    "qa:e2e-env": "node scripts/check-local-e2e-env.mjs",
    "qa:ocr-corpus": "node scripts/check-ocr-corpus.mjs",
    "qa:ocr-media": "node scripts/run-synthetic-ocr-media-benchmark.mjs",
    "generate:ocr-media": "node scripts/generate-synthetic-ocr-media.mjs",
    "qa:ocr-corpus:private": "OCR_CORPUS_DIR=tests/fixtures/ocr-corpus/private OCR_CORPUS_REQUIRED=1 node scripts/check-ocr-corpus.mjs && OCR_CORPUS_DIR=tests/fixtures/ocr-corpus/private vitest run src/lib/ocr/__tests__/warranty-field-parser.test.ts --maxWorkers=1",
    "qa:pentest-readiness": "node scripts/check-pentest-readiness.mjs",
    "qa:security-assurance": "node scripts/run-internal-security-assurance.mjs",
    "qa:migrations": "node scripts/check-migration-integrity.mjs",
    "qa:agent-readiness": "node scripts/check-agent-readiness.mjs",
    "architecture:generate": "node scripts/generate-architecture-map.mjs",
    "qa:architecture-map": "node scripts/generate-architecture-map.mjs --check",
    "agent-markdown:generate": "node scripts/generate-agent-markdown.mjs",
    "agent-markdown:check": "node scripts/generate-agent-markdown.mjs --check",
    "qa:agent-markdown": "node scripts/check-agent-markdown.mjs",
    "qa:agent-markdown:local": "node scripts/run-agent-markdown-local-gate.mjs",
    "qa:html-preservation": "node scripts/check-html-preservation.mjs",
    "qa:frontend-budget": "node scripts/check-frontend-performance-budget.mjs",
    "qa:growth-readiness": "node scripts/check-growth-readiness.mjs",
    "crm:reconcile": "node scripts/reconcile-twenty-leads.mjs",
    "qa:full-local": "node scripts/run-local-full-qa.mjs",
    "qa:user:ensure": "node scripts/manage-production-qa-user.mjs ensure",
    "qa:user:cleanup": "node scripts/manage-production-qa-user.mjs cleanup",
    "qa:user:verify-clean": "node scripts/manage-production-qa-user.mjs verify-clean",
    "campaign:links": "node scripts/generate-campaign-links.mjs",
    "publish:cli": "npm publish ./packages/warrantee-cli --access public",
    "smoke:prod": "node scripts/production-smoke.mjs",
    "load:prod": "node scripts/production-load-check.mjs",
    "readiness:operational": "node scripts/operational-readiness-check.mjs",
    "observability:sentry": "node scripts/sentry-release-readiness.mjs --vercel-production",
    "observability:sentry-issues": "node scripts/sentry-issue-readiness.mjs",
    "guard:loopback": "node scripts/check-no-loopback-links.mjs",
    "security:rls-probe": "node scripts/security-probe-supabase-rls.mjs",
    "security:apply-rls": "scripts/apply-supabase-rls.sh",
    "indexnow:submit": "node scripts/indexnow-submit.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.98",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.503.0",
    "next": "^15.5.21",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "6.2.108",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.0.9",
    "resend": "^6.18.0",
    "stripe": "^22.1.1",
    "tesseract.js": "^5.1.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/pdfkit": "^0.17.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.6",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "caniuse-lite": "^1.0.30001793",
    "cheerio": "^1.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
